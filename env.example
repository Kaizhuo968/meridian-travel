# Environment variables / secrets template
#
# 1. Copy this file to `.env` (which is gitignored) and fill in real values.
# 2. For production, DO NOT put real secrets in .env committed to the repo.
#    Instead configure these in your hosting platform:
#      - Vercel: Project Settings → Environment Variables
#      - GitHub Actions: Repo Settings → Secrets and variables → Actions
#    The build step (scripts/build-env.mjs) reads them and writes
#    env.generated.js, which is also gitignored.
#
# SECURITY NOTE:
#   OPENAI_API_KEY and STRIPE_SECRET are SERVER-ONLY secrets.
#   Never expose them to the browser. Use a backend / serverless function.

PADDLE_API_KEY=
OPENAI_API_KEY=
SUPABASE_KEY=

# Stripe secret key — server-side only, never ship to the client.
STRIPE_SECRET=
